<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Пустой набор прав. xtool сам добавит права, необходимые для подписи.

	Системный VPN (NetworkExtension) требует платного Apple Developer Program.
	Если у вас есть платная подпись, раскомментируйте ключи ниже:

	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	-->
</dict>
</plist>
